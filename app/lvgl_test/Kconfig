#
# Contest 2026 team 094 LVGL framebuffer test app
#

config LVX_USE_DEMO_CONTEST2026_094_LVGL_TEST
	bool "Contest 2026 team 094 LVGL framebuffer test"
	default n
	depends on GRAPHICS_LVGL && LV_USE_NUTTX
	depends on VIDEO_FB && FB_UPDATE
	depends on INPUT_TOUCHSCREEN && LV_USE_NUTTX_TOUCHSCREEN
	depends on D13X_KEYADC
	---help---
		Enable the lvgl_test NSH command. It renders a bounded interactive
		1024x600 LVGL test page through /dev/fb0, /dev/input0, and the
			separate /dev/dpad focus-navigation device. WAKEUP is reserved
			for system power management.
