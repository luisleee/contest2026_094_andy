/dts-v1/;

/ {
    description = "nuttx-artinchip firmware";
    #address-cells = <1>;

    images {
        version = "1.0.0";
        seg0 {
            description = "Artinchip D13X segment 0";
            data = /incbin/("./nuttx.bin");
            type = "firmware";
            arch = "riscv";
            os = "artinchip";
            load = <0x30044100>;
            entry = <0x30044100>;
            hash-1 {
                algo = "crc32";
            };
            hash-2 {
                algo = "md5";
            };
        };
    };

    configurations {
        default = "conf-1";
        conf-1 {
            description = "nuttx-artinchip firmware";
            firmware = "seg0";
        };
    };
};
